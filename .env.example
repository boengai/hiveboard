# ── GitHub Auth (required — choose one) ───────────────
# Option A: Personal access token (ghp_ or github_pat_ prefix)
GITHUB_TOKEN=ghp_your_token_here

# Option B: GitHub App (set these INSTEAD of GITHUB_TOKEN)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID=12345678

# NOTE: Bare installation tokens (ghs_) are not supported.
# If you have a GitHub App, use Option B with all three env vars.

# ── GitHub OAuth (required for remote/internet access) ─
# GITHUB_OAUTH_CLIENT_ID=your_oauth_app_client_id
# GITHUB_OAUTH_CLIENT_SECRET=your_oauth_app_client_secret
# SESSION_SECRET=replace-with-32-random-bytes-for-signing-oauth-state-cookies

# ── CORS (required in production) ─────────────────────
# Comma-separated list of allowed origins for credentialed requests.
# In development, defaults to http://localhost:$WEB_PORT + http://localhost:$API_PORT.
# In production, this MUST be set or the API will refuse to start.
# CORS_ALLOWED_ORIGINS=https://hiveboard.example.com

# ── Per-task secrets encryption (required for secrets feature) ───────
# Used to derive a KEK (HKDF-SHA256) that AES-256-GCM-encrypts board_secrets
# and task_secrets rows. Must decode to ≥32 bytes.
#
# Generate with:
#   openssl rand -base64 32
#
# If unset, the per-task secrets feature is disabled: mutations return
# SECRETS_DISABLED and any task with non-empty required_secrets transitions
# to MISSING_SECRETS. Existing ciphertext stays on disk, unusable until
# the same key is restored.
#
# Rotating this value renders every stored secret unreadable; re-enter them
# via the UI.
HIVEBOARD_SECRETS_KEY=replace-with-output-of-openssl-rand-base64-32

# ── Ports ─────────────────────────────────────────────
# API_PORT=8080          # API server (default: 8080)
# API_TMP_PATH=./tmp     # API temporary path (default: ./tmp)
# WEB_PORT=5173          # Vite dev server, local dev only (default: 5173)